<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Details</title>
    <link rel="stylesheet" href="/styles/contact.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <script src="/scripts/contact.js" defer></script>
  </head>

  <body class="overpass-medium">
    <div class="page-container">
      <header>
        <a href="/contacts" aria-label="Go back to homepage">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#000000"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-big-left-dash-icon lucide-arrow-big-left-dash"
          >
            <path
              d="M13 9a1 1 0 0 1-1-1V5.061a1 1 0 0 0-1.811-.75l-6.835 6.836a1.207 1.207 0 0 0 0 1.707l6.835 6.835a1 1 0 0 0 1.811-.75V16a1 1 0 0 1 1-1h2a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1z"
            />
            <path d="M20 9v6" />
          </svg>
        </a>
        <h1 class="overpass-medium">Contact Details</h1>
      </header>
      <main>
        <div class="contact-icon-container">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="72"
            height="72"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-circle-user-round-icon lucide-circle-user-round"
          >
            <path d="M18 20a6 6 0 0 0-12 0" />
            <circle cx="12" cy="10" r="4" />
            <circle cx="12" cy="12" r="10" />
          </svg>
        </div>

        <h2 class="contact-name overpass-medium">
          <%= contact.first_name %> <%= contact.last_name %>
        </h2>
        <ul class="contact-other-details">
          <li class="contact-phone-number">
            <span class="label">Phone Number:</span>
            <span class="info"><%= contact.phone_number %></span>
          </li>
          <li>
            <span class="label">Category:</span>
            <span class="info"
              ><%= contact.category_is_default ? 'Default' :
              contact.category_name %></span
            >
          </li>
          <% if (contact.email && contact.email.trim() !== "") {%>
          <li class="contact-email">
            <span class="label">Email Address:</span>
            <span class="info"><%= contact.email %></span>
          </li>
          <% } %>
          <li class="contact-create-date">
            <span class="label">Created On:</span
            ><span class="info"> <%= contact.formatted_date %></span>
          </li>
        </ul>
        <div class="forms-container">
          <!-- Edit button -->
          <form
            class="edit-contact"
            action="/contacts/<%= contact.id %>/edit"
            method="get"
          >
            <button type="submit" class="btn-edit">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-pencil-icon lucide-pencil"
              >
                <path
                  d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
                />
                <path d="m15 5 4 4" />
              </svg>
              <span>Edit</span>
            </button>
          </form>

          <!-- Delete button -->
          <button
            type="button"
            onclick="showDeleteDialog(event)"
            data-contact-id="<%= contact.id %>"
            class="btn-delete"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-trash-2"
            >
              <path d="M3 6h18" />
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
              <line x1="10" x2="10" y1="11" y2="17" />
              <line x1="14" x2="14" y1="11" y2="17" />
            </svg>
            <span>Delete</span>
          </button>
        </div>

        <dialog id="deleteDialog">
          <div class="dialog-content">
            <h2>Delete Contact</h2>
            <p>Enter the deletion code to confirm:</p>

            <input
              type="password"
              id="deleteCodeInput"
              placeholder="Enter code"
              autocomplete="off"
              required
            />

            <p
              id="errorMessage"
              style="color: red; display: none; margin-top: 10px"
            ></p>

            <div class="dialog-buttons">
              <button type="button" onclick="closeDeleteDialog()">
                Cancel
              </button>
              <button
                type="button"
                onclick="confirmDelete()"
                class="delete-btn"
              >
                Delete
              </button>
            </div>
          </div>
        </dialog>
      </main>
    </div>
  </body>
</html>
