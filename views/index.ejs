<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phone Book</title>
    <link rel="stylesheet" href="/styles/index.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="overpass-medium">
    <div class="page-container">
      <header>
        <h1>Phone Book</h1>
        <a href="/categories">Categories</a>
      </header>
      <% if (locals.contacts && contacts.length > 0) { %>
      <main class="contacts-container">
        <h2 class="overpass-bold">
          <span>contact list:</span
          ><span class="overpass-medium-italic contacts-count"
            >(<%= contacts.length %>)</span
          >
        </h2>
        <ul>
          <% contacts.forEach(function(contact) { %>
          <li>
            <a href="/contacts/<%= contact.id %>" class="contact">
              <div class="contact-icon-container">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-circle-user-round-icon lucide-circle-user-round"
                >
                  <path d="M18 20a6 6 0 0 0-12 0" />
                  <circle cx="12" cy="10" r="4" />
                  <circle cx="12" cy="12" r="10" />
                </svg>
              </div>
              <div class="contact-details">
                <span class="contact-name"
                  ><%= contact.first_name %>
                  <%= contact.last_name %></span
                >
                <span class="contact-number overpass-light-italic"
                  ><%= contact.phone_number %></span
                >
              </div>
            </a>
            <a
              href="/contacts/<%= contact.id %>/edit"
              title="Edit Contact"
              aria-label="Edit contact"
              class="edit-contact"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-user-pen-icon lucide-user-pen"
              >
                <path d="M11.5 15H7a4 4 0 0 0-4 4v2" />
                <path
                  d="M21.378 16.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"
                />
                <circle cx="10" cy="7" r="4" />
              </svg>
            </a>
          </li>
          <% }); %>
        </ul>
      </main>
      <% } else { %>
      <main class="empty-contact-list">
        <div class="img-container">
          <img
            src="/images/empty-contacts.png"
            alt="No contacts in phone book"
          />
        </div>
        <p>There are no contacts yet.</p>
      </main>
      <% } %>
      <form
        class="create-contact-container"
        action="/contacts/new"
        method="get"
      >
        <button type="submit" aria-label="Add new contact">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="#ffffff"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-plus-icon lucide-plus"
          >
            <path d="M5 12h14" />
            <path d="M12 5v14" />
          </svg>
        </button>
      </form>
    </div>
  </body>
</html>
