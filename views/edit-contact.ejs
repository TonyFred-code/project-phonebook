<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Contact</title>
    <link rel="stylesheet" href="/styles/edit-contact.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="overpass-regular">
    <div class="page-container">
      <header>
        <a
          href="javascript:history.back()"
          aria-label="Go back to previous page"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#000000"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M13 9a1 1 0 0 1-1-1V5.061a1 1 0 0 0-1.811-.75l-6.835 6.836a1.207 1.207 0 0 0 0 1.707l6.835 6.835a1 1 0 0 0 1.811-.75V16a1 1 0 0 1 1-1h2a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1z"
            />
            <path d="M20 9v6" />
          </svg>
        </a>
        <h1 class="overpass-medium">Edit Contact</h1>
      </header>
      <% if (typeof errors !== "undefined" && errors.length > 0) { %>
      <div class="error-messages">
        <ul>
          <% errors.forEach(error => { %>
          <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
      <% } %>
      <main>
        <form
          method="post"
          action="/contacts/<%= contact.id %>/update"
          id="edit-contact-form"
        >
          <div>
            <label for="first_name">first name <span>*</span>:</label>
            <input
              type="text"
              autocomplete="given-name"
              name="first_name"
              id="first_name"
              placeholder="First Name"
              required
              title="Enter your first name (given name)"
              value="<%= contact.first_name %>"
            />
          </div>
          <div>
            <label for="last_name">last name <span>*</span>:</label>
            <input
              type="text"
              autocomplete="family-name"
              name="last_name"
              id="last_name"
              placeholder="Last Name"
              required
              title="Enter your last name (surname)"
              value="<%= contact.last_name %>"
            />
          </div>
          <div>
            <label for="phone_number">phone number <span>*</span>:</label>
            <input
              type="tel"
              autocomplete="tel"
              name="phone_number"
              id="phone_number"
              pattern="^\+?[0-9\s\-]{7,15}$"
              title="Please enter a valid phone number (e.g., +234...)"
              placeholder="+234__________"
              required
              value="<%= contact.phone_number %>"
            />
          </div>
          <div>
            <label for="email">email address:</label>
            <input
              type="email"
              placeholder="Email Address"
              autocomplete="email"
              name="email"
              id="email"
              value="<%= contact.email || '' %>"
            />
          </div>
          <div>
            <label for="contact_category">contact category</label>
            <select name="category_id" id="contact_category">
              <% for (let i = 0; i < categories.length; i++) { %> <% if
              (categories[i].id === contact.category_id) { %>
              <option value="<%= categories[i].id %>" selected>
                <%= categories[i].is_default ? '-- Default (Unassigned) --' : categories[i].name %>
              </option>
              <% } else { %>
              <option value="<%= categories[i].id %>">
                <%= categories[i].is_default ? '-- Default (Unassigned) --' :
                categories[i].name %>
              </option>
              <% } %>
              <% } %>
            </select>
          </div>

          <div class="button-container">
            <button
              type="submit"
              form="edit-contact-form"
              aria-label="Update contact"
              class="overpass-bold"
            >
              <span>Update</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-check-check-icon lucide-check-check"
              >
                <path d="M18 6 7 17l-5-5" />
                <path d="m22 10-7.5 7.5L13 16" />
              </svg>
            </button>
          </div>
        </form>
      </main>
    </div>
  </body>
</html>
