<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Category Details</title>
    <link rel="stylesheet" href="/styles/category.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <script src="/scripts/category.js" defer></script>
  </head>

  <body class="overpass-medium">
    <div class="page-container">
      <header>
        <a
          href="javascript:history.back()"
          aria-label="Go back to previous page"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#000000"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M13 9a1 1 0 0 1-1-1V5.061a1 1 0 0 0-1.811-.75l-6.835 6.836a1.207 1.207 0 0 0 0 1.707l6.835 6.835a1 1 0 0 0 1.811-.75V16a1 1 0 0 1 1-1h2a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1z"
            />
            <path d="M20 9v6" />
          </svg>
        </a>
        <h1 class="overpass-bold">Category Details</h1>
      </header>
      <main>
        <section class="category-details">
          <div class="category-icon-container">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="72"
              height="72"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 20a6 6 0 0 0-12 0" />
              <circle cx="12" cy="10" r="4" />
              <circle cx="12" cy="12" r="10" />
            </svg>
          </div>
          <h2 class="category-name overpass-medium">
            <%= category.is_default ? "default (unassigned)" : category.name %>
          </h2>
          <p class="category-description">
            <span class="label">description: </span
            ><%= category.description ? category.description : 'No description.' %>
          </p>
          <% if (!category.is_default) { %>
          <div class="forms-container">
            <!-- Edit button -->
            <form
              class="edit-contact"
              action="/categories/<%= category.id %>/edit"
              method="get"
            >
              <button type="submit" class="btn-edit">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-pencil-icon lucide-pencil"
                >
                  <path
                    d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
                  />
                  <path d="m15 5 4 4" />
                </svg>
                <span>Edit</span>
              </button>
            </form>
            <!-- Delete button -->
            <button
              type="button"
              onclick="showDeleteDialog(event)"
              data-category-id="<%= category.id %>"
              class="btn-delete"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-trash-2"
              >
                <path d="M3 6h18" />
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                <line x1="10" x2="10" y1="11" y2="17" />
                <line x1="14" x2="14" y1="11" y2="17" />
              </svg>
              <span>Delete</span>
            </button>
          </div>
          <% } %>
        </section>
        <section class="category-contacts">
          <h3>category contacts</h3>
          <% if (category.contacts && category.contacts.length > 0) { %>
          <ul>
            <% category.contacts.forEach(function(contact) { %>
            <li>
              <a href="/contacts/<%= contact.id %>" class="contact">
                <div class="contact-icon-container">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-circle-user-round-icon lucide-circle-user-round"
                  >
                    <path d="M18 20a6 6 0 0 0-12 0" />
                    <circle cx="12" cy="10" r="4" />
                    <circle cx="12" cy="12" r="10" />
                  </svg>
                </div>
                <div class="contact-details">
                  <span class="contact-name"
                    ><%= contact.first_name %>
                    <%= contact.last_name %></span
                  >
                  <span class="contact-number overpass-light-italic"
                    ><%= contact.phone_number %></span
                  >
                </div>
              </a>
            </li>
            <% }); %>
          </ul>
          <% } else {%>
          <p class="null-categories-contact">
            No contact exists in this category.
          </p>
          <% } %>
        </section>

        <dialog id="deleteDialog">
          <div class="dialog-content">
            <h2>Delete Category</h2>
            <p>Enter the deletion code to confirm:</p>

            <input
              type="password"
              id="deleteCodeInput"
              placeholder="Enter code"
              autocomplete="off"
              required
            />

            <p
              id="errorMessage"
              style="color: red; display: none; margin-top: 10px"
            ></p>

            <div class="dialog-buttons">
              <button type="button" onclick="closeDeleteDialog()">
                Cancel
              </button>
              <button
                type="button"
                onclick="confirmDelete()"
                class="delete-btn"
              >
                Delete
              </button>
            </div>
          </div>
        </dialog>
      </main>
    </div>
  </body>
</html>
